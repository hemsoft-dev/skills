##---------------------------------------
## Alias: code -> code-insiders
##---------------------------------------
# Gemini CLI and other tools expect 'code' command
# Redirect to VS Code Insiders
function code { code-insiders $args }

##---------------------------------------
## OpenCode: Quick ask function
##---------------------------------------
# Uses Claude 3.5 Haiku via OpenRouter (cheaper than Sonnet)
function opencode-ask { opencode run -m "openrouter/anthropic/claude-3.5-haiku" $args }

##---------------------------------------
## Copilot: Free tier function
##---------------------------------------
# Uses GPT-5 Mini (free tier) with all permissions auto-approved (silent output)
function copilot-free { copilot --allow-all --model gpt-5-mini --silent --prompt $args }
