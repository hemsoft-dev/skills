{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "YouTube Video Metadata Schema",
  "description": "Schema for YouTube video metadata extracted via ytd (yt-dlp) tool",
  "type": "object",
  "required": [
    "id",
    "title",
    "url",
    "upload_date",
    "publishDate",
    "duration",
    "channel",
    "channel_id",
    "description",
    "base_filename",
    "date_downloaded"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "YouTube video ID (11 characters)",
      "pattern": "^[a-zA-Z0-9_-]{11}$",
      "examples": ["H0SGK1yPHD0"]
    },
    "title": {
      "type": "string",
      "description": "Full video title as provided by YouTube",
      "minLength": 1,
      "examples": ["ASP.NET Community Standup - The MCP authorization flow"]
    },
    "title_short": {
      "type": "string",
      "description": "Shortened, URL-friendly version of title (max ~50 chars, used in filenames)",
      "maxLength": 60,
      "examples": ["aspnet-mcp-auth"]
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Full YouTube URL",
      "pattern": "^https://www\\.youtube\\.com/watch\\?v=",
      "examples": ["https://www.youtube.com/watch?v=H0SGK1yPHD0"]
    },
    "upload_date": {
      "type": "string",
      "description": "Date video was published on YouTube (YYYY-MM-DD format)",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "examples": ["2025-10-22"]
    },
    "publishDate": {
      "type": "string",
      "description": "Formatted publish date (YYYY-MM-DD format)",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "examples": ["2025-10-22"]
    },
    "duration": {
      "type": "integer",
      "description": "Video duration in seconds",
      "minimum": 1,
      "examples": [2839]
    },
    "duration_formatted": {
      "type": "string",
      "description": "Human-readable duration (MM:SS or HH:MM:SS)",
      "pattern": "^(\\d+:)?\\d{1,2}:\\d{2}$",
      "examples": ["47:19", "1:22:42"]
    },
    "channel": {
      "type": "string",
      "description": "YouTube channel name",
      "minLength": 1,
      "examples": ["dotnet"]
    },
    "channel_id": {
      "type": "string",
      "description": "YouTube channel ID",
      "pattern": "^UC[a-zA-Z0-9_-]{22}$",
      "examples": ["UCvtT19MZW8dq5Wwfu6B0oxw"]
    },
    "channel_url": {
      "type": "string",
      "format": "uri",
      "description": "Full URL to the YouTube channel",
      "examples": ["https://www.youtube.com/channel/UCvtT19MZW8dq5Wwfu6B0oxw"]
    },
    "uploader": {
      "type": "string",
      "description": "Uploader name (often same as channel)",
      "examples": ["dotnet"]
    },
    "uploader_id": {
      "type": "string",
      "description": "Uploader ID with @ prefix",
      "pattern": "^@",
      "examples": ["@dotnet"]
    },
    "description": {
      "type": "string",
      "description": "Full video description from YouTube"
    },
    "categories": {
      "type": "array",
      "description": "YouTube categories assigned to the video",
      "items": {
        "type": "string"
      },
      "examples": [["Science & Technology"]]
    },
    "tags": {
      "type": "array",
      "description": "Tags/keywords assigned to the video",
      "items": {
        "type": "string"
      },
      "examples": [["aspnetcore", "asp.net", "mcp", "modelcontextprotocol"]]
    },
    "view_count": {
      "type": "integer",
      "description": "Number of views at time of download",
      "minimum": 0,
      "examples": [2094]
    },
    "like_count": {
      "type": "integer",
      "description": "Number of likes at time of download",
      "minimum": 0,
      "examples": [51]
    },
    "comment_count": {
      "type": "integer",
      "description": "Number of comments at time of download",
      "minimum": 0,
      "examples": [1]
    },
    "thumbnail": {
      "type": "string",
      "format": "uri",
      "description": "URL to video thumbnail image",
      "examples": ["https://i.ytimg.com/vi/H0SGK1yPHD0/maxresdefault.jpg"]
    },
    "resolution": {
      "type": "string",
      "description": "Video resolution (width x height)",
      "pattern": "^\\d+x\\d+$",
      "examples": ["1920x1080"]
    },
    "fps": {
      "type": "number",
      "description": "Frames per second",
      "minimum": 0,
      "examples": [30.0]
    },
    "vcodec": {
      "type": "string",
      "description": "Video codec identifier",
      "examples": ["avc1.640028"]
    },
    "acodec": {
      "type": "string",
      "description": "Audio codec identifier",
      "examples": ["mp4a.40.2"]
    },
    "filesize_approx": {
      "type": ["integer", "null"],
      "description": "Approximate file size in bytes (may be null)",
      "minimum": 0
    },
    "base_filename": {
      "type": "string",
      "description": "Base filename for all generated files (YYYY-MM-DD - title-short)",
      "pattern": "^\\d{4}-\\d{2}-\\d{2} - [a-z0-9-]+$",
      "examples": ["2025-10-22 - aspnet-mcp-auth"]
    },
    "date_downloaded": {
      "type": "string",
      "description": "Date metadata was downloaded (YYYY-MM-DD format)",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "examples": ["2025-10-25"]
    },
    "has_transcript": {
      "type": "boolean",
      "description": "Whether video has auto-generated or manual captions available",
      "default": false
    }
  },
  "additionalProperties": false
}
