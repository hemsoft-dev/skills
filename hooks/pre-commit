#!/bin/sh
# Managed by Install-GitHooks.ps1 — source of truth is the hooks/ folder in this repo.
# Windows Git hook wrapper - calls PowerShell, Markdown, and skills lint checks.
# Resolves the shared hooks directory so linked worktrees find the installed hooks.

HOOKS_DIR="$(git rev-parse --path-format=absolute --git-common-dir)/hooks"
EXIT_CODE=0

for hook in pre-commit.ps1 pre-commit-markdown.ps1 pre-commit-skills-lint.ps1; do
  pwsh.exe -NoProfile -ExecutionPolicy Bypass -File "$HOOKS_DIR/$hook"
  if [ $? -ne 0 ]; then
    EXIT_CODE=1
  fi
done

exit $EXIT_CODE
