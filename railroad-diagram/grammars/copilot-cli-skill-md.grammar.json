{
  "meta": {
    "title": "GitHub Copilot CLI — SKILL.md Frontmatter",
    "description": "Railroad diagram for the YAML frontmatter schema of agent skills (SKILL.md) per GitHub Copilot CLI documentation (docs.github.com)",
    "source": "https://docs.github.com/en/copilot/how-tos/copilot-cli/customize-copilot/create-skills",
    "version": "2026-04"
  },
  "rules": {
    "SKILL.md File": {
      "description": "Complete structure of a SKILL.md agent skill file",
      "definition": {
        "type": "Sequence",
        "items": [
          "---",
          { "type": "NonTerminal", "label": "Frontmatter" },
          "---",
          { "type": "NonTerminal", "label": "Markdown Body" }
        ]
      }
    },

    "Frontmatter": {
      "description": "Required and optional YAML fields",
      "definition": {
        "type": "Stack",
        "items": [
          {
            "type": "Sequence",
            "items": [
              { "type": "Comment", "label": "required" },
              "name:",
              { "type": "Terminal", "label": "lowercase-hyphenated-id" }
            ]
          },
          {
            "type": "Sequence",
            "items": [
              { "type": "Comment", "label": "required" },
              "description:",
              { "type": "Terminal", "label": "quoted string (what + when to use)" }
            ]
          },
          {
            "type": "Optional",
            "items": [
              {
                "type": "Sequence",
                "items": [
                  "license:",
                  { "type": "Terminal", "label": "SPDX or free text" }
                ]
              }
            ],
            "skip": true
          },
          {
            "type": "Optional",
            "items": [
              { "type": "NonTerminal", "label": "Allowed-Tools Field" }
            ],
            "skip": true
          },
          {
            "type": "Optional",
            "items": [
              {
                "type": "Sequence",
                "items": [
                  "compatibility:",
                  { "type": "Terminal", "label": "free-text requirements" }
                ]
              }
            ],
            "skip": true
          },
          {
            "type": "Optional",
            "items": [
              { "type": "NonTerminal", "label": "Hooks Block" }
            ],
            "skip": true
          }
        ]
      }
    },

    "Allowed-Tools Field": {
      "description": "Space-separated list of pre-approved tools (WARNING: shell/bash bypass confirmation)",
      "definition": {
        "type": "Sequence",
        "items": [
          "allowed-tools:",
          {
            "type": "OneOrMore",
            "items": [
              { "type": "NonTerminal", "label": "Tool Spec" },
              { "type": "Terminal", "label": " " }
            ]
          }
        ]
      }
    },

    "Tool Spec": {
      "description": "A single tool permission: simple name or qualified pattern",
      "definition": {
        "type": "Choice",
        "default": 0,
        "items": [
          {
            "type": "Choice",
            "default": 0,
            "items": [
              { "type": "Terminal", "label": "shell" },
              { "type": "Terminal", "label": "bash" },
              { "type": "Terminal", "label": "Read" },
              { "type": "Terminal", "label": "Write" },
              { "type": "Terminal", "label": "Edit" }
            ]
          },
          {
            "type": "Sequence",
            "items": [
              {
                "type": "Choice",
                "default": 0,
                "items": [
                  { "type": "Terminal", "label": "Bash" },
                  { "type": "Terminal", "label": "Shell" }
                ]
              },
              "(",
              { "type": "Terminal", "label": "glob:pattern" },
              ")"
            ]
          }
        ]
      }
    },

    "Hooks Block": {
      "description": "Lifecycle hooks — PostToolUse runs after tool calls; Stop runs before session ends",
      "definition": {
        "type": "Sequence",
        "items": [
          "hooks:",
          {
            "type": "Optional",
            "items": [
              {
                "type": "Group",
                "label": "PostToolUse",
                "items": [
                  {
                    "type": "Sequence",
                    "items": [
                      "PostToolUse:",
                      { "type": "NonTerminal", "label": "Hook Entry List" }
                    ]
                  }
                ]
              }
            ],
            "skip": true
          },
          {
            "type": "Optional",
            "items": [
              {
                "type": "Group",
                "label": "Stop",
                "items": [
                  {
                    "type": "Sequence",
                    "items": [
                      "Stop:",
                      { "type": "NonTerminal", "label": "Hook Entry List" }
                    ]
                  }
                ]
              }
            ],
            "skip": true
          }
        ]
      }
    },

    "Hook Entry List": {
      "description": "One or more hook entries, each with a matcher and hook steps",
      "definition": {
        "type": "OneOrMore",
        "items": [
          { "type": "NonTerminal", "label": "Hook Entry" }
        ]
      }
    },

    "Hook Entry": {
      "description": "A single hook entry: matcher pattern + list of hook steps",
      "definition": {
        "type": "Sequence",
        "items": [
          "-",
          "matcher:",
          { "type": "Terminal", "label": "pattern (e.g. Read|Write|Edit or *)" },
          "hooks:",
          { "type": "NonTerminal", "label": "Hook Step List" }
        ]
      }
    },

    "Hook Step List": {
      "description": "One or more hook steps to execute",
      "definition": {
        "type": "OneOrMore",
        "items": [
          { "type": "NonTerminal", "label": "Hook Step" }
        ]
      }
    },

    "Hook Step": {
      "description": "A single hook action — prompt injection or command execution",
      "definition": {
        "type": "Sequence",
        "items": [
          "-",
          "type:",
          {
            "type": "Choice",
            "default": 0,
            "items": [
              {
                "type": "Sequence",
                "items": [
                  { "type": "Terminal", "label": "prompt" },
                  "prompt:",
                  { "type": "Terminal", "label": "multiline YAML string" }
                ]
              },
              {
                "type": "Sequence",
                "items": [
                  { "type": "Terminal", "label": "command" },
                  {
                    "type": "Optional",
                    "items": [
                      {
                        "type": "Sequence",
                        "items": [
                          "bash:",
                          { "type": "Terminal", "label": "shell command" }
                        ]
                      }
                    ],
                    "skip": true
                  },
                  {
                    "type": "Optional",
                    "items": [
                      {
                        "type": "Sequence",
                        "items": [
                          "powershell:",
                          { "type": "Terminal", "label": "PS command" }
                        ]
                      }
                    ],
                    "skip": true
                  }
                ]
              }
            ]
          }
        ]
      }
    },

    "Markdown Body": {
      "description": "Free-form Markdown instructions, examples, and guidelines for the agent",
      "definition": {
        "type": "Sequence",
        "items": [
          {
            "type": "Optional",
            "items": [
              {
                "type": "Sequence",
                "items": [
                  { "type": "Terminal", "label": "# Heading" },
                  { "type": "Terminal", "label": "instructions prose" }
                ]
              }
            ],
            "skip": true
          },
          {
            "type": "Optional",
            "items": [
              {
                "type": "Sequence",
                "items": [
                  { "type": "Terminal", "label": "## Commands" },
                  { "type": "Terminal", "label": "command table" }
                ]
              }
            ],
            "skip": true
          },
          {
            "type": "ZeroOrMore",
            "items": [
              {
                "type": "Sequence",
                "items": [
                  { "type": "Terminal", "label": "## Section" },
                  { "type": "Terminal", "label": "content" }
                ]
              }
            ]
          }
        ]
      }
    }
  }
}
