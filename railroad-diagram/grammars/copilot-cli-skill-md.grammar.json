{
  "meta": {
    "title": "GitHub Copilot — SKILL.md Frontmatter",
    "description": "Railroad diagram for the YAML frontmatter schema of agent skills (SKILL.md) per agentskills.io specification and GitHub Copilot documentation. Covers Cloud Agent, CLI, and VS Code agent mode.",
    "source": "https://agentskills.io/specification",
    "version": "2026-04"
  },
  "rules": {
    "SKILL.md File": {
      "description": "Complete structure of a SKILL.md agent skill file",
      "definition": {
        "type": "Sequence",
        "items": [
          "---",
          { "type": "NonTerminal", "label": "Frontmatter" },
          "---",
          { "type": "NonTerminal", "label": "Markdown Body" }
        ]
      }
    },

    "Frontmatter": {
      "description": "Required and optional YAML fields per agentskills.io spec",
      "definition": {
        "type": "Stack",
        "items": [
          {
            "type": "Sequence",
            "items": [
              { "type": "Comment", "label": "required" },
              "name:",
              { "type": "Terminal", "label": "lowercase-hyphenated-id" }
            ]
          },
          {
            "type": "Sequence",
            "items": [
              { "type": "Comment", "label": "required" },
              "description:",
              { "type": "Terminal", "label": "quoted string (what + when to use)" }
            ]
          },
          {
            "type": "Optional",
            "items": [
              {
                "type": "Sequence",
                "items": [
                  "license:",
                  { "type": "Terminal", "label": "SPDX or free text" }
                ]
              }
            ],
            "skip": true
          },
          {
            "type": "Optional",
            "items": [
              {
                "type": "Sequence",
                "items": [
                  "compatibility:",
                  { "type": "Terminal", "label": "free-text requirements (max 500 chars)" }
                ]
              }
            ],
            "skip": true
          },
          {
            "type": "Optional",
            "items": [
              { "type": "NonTerminal", "label": "Metadata Block" }
            ],
            "skip": true
          },
          {
            "type": "Optional",
            "items": [
              { "type": "NonTerminal", "label": "Allowed-Tools Field" }
            ],
            "skip": true
          }
        ]
      }
    },

    "Allowed-Tools Field": {
      "description": "Space-separated list of pre-approved tools (WARNING: shell/bash bypass confirmation)",
      "definition": {
        "type": "Sequence",
        "items": [
          "allowed-tools:",
          {
            "type": "OneOrMore",
            "items": [
              { "type": "NonTerminal", "label": "Tool Spec" },
              { "type": "Terminal", "label": " " }
            ]
          }
        ]
      }
    },

    "Metadata Block": {
      "description": "Arbitrary key-value mapping for additional metadata (clients use this for non-spec properties)",
      "definition": {
        "type": "Sequence",
        "items": [
          "metadata:",
          {
            "type": "OneOrMore",
            "items": [
              {
                "type": "Sequence",
                "items": [
                  { "type": "Terminal", "label": "key" },
                  ":",
                  { "type": "Terminal", "label": "string value" }
                ]
              }
            ]
          }
        ]
      }
    },

    "Tool Spec": {
      "description": "A single tool permission: simple name or qualified pattern",
      "definition": {
        "type": "Choice",
        "default": 0,
        "items": [
          {
            "type": "Choice",
            "default": 0,
            "items": [
              { "type": "Terminal", "label": "shell" },
              { "type": "Terminal", "label": "bash" },
              { "type": "Terminal", "label": "Read" },
              { "type": "Terminal", "label": "Write" },
              { "type": "Terminal", "label": "Edit" }
            ]
          },
          {
            "type": "Sequence",
            "items": [
              {
                "type": "Choice",
                "default": 0,
                "items": [
                  { "type": "Terminal", "label": "Bash" },
                  { "type": "Terminal", "label": "Shell" }
                ]
              },
              "(",
              { "type": "Terminal", "label": "glob:pattern" },
              ")"
            ]
          }
        ]
      }
    },

    "Markdown Body": {
      "description": "Free-form Markdown instructions, examples, and guidelines for the agent",
      "definition": {
        "type": "Sequence",
        "items": [
          {
            "type": "Optional",
            "items": [
              {
                "type": "Sequence",
                "items": [
                  { "type": "Terminal", "label": "# Heading" },
                  { "type": "Terminal", "label": "instructions prose" }
                ]
              }
            ],
            "skip": true
          },
          {
            "type": "Optional",
            "items": [
              {
                "type": "Sequence",
                "items": [
                  { "type": "Terminal", "label": "## Commands" },
                  { "type": "Terminal", "label": "command table" }
                ]
              }
            ],
            "skip": true
          },
          {
            "type": "ZeroOrMore",
            "items": [
              {
                "type": "Sequence",
                "items": [
                  { "type": "Terminal", "label": "## Section" },
                  { "type": "Terminal", "label": "content" }
                ]
              }
            ]
          }
        ]
      }
    }
  }
}
