{
  "meta": {
    "title": "VS Code Prompt File (.prompt.md) Frontmatter",
    "description": "Railroad diagram for the YAML frontmatter schema of VS Code prompt files (.prompt.md)",
    "source": "https://code.visualstudio.com/docs/copilot/customization/prompt-files",
    "version": "2026-04"
  },
  "rules": {
    "prompt-md File": {
      "description": "Complete structure of a .prompt.md prompt file",
      "definition": {
        "type": "Sequence",
        "items": [
          { "type": "Optional", "items": [
            { "type": "Sequence", "items": [
              "---",
              { "type": "NonTerminal", "label": "Frontmatter Fields" },
              "---"
            ]}
          ], "skip": true },
          { "type": "NonTerminal", "label": "Body (Markdown)" }
        ]
      }
    },

    "Frontmatter Fields": {
      "description": "All available YAML frontmatter fields for prompt files (all optional)",
      "definition": {
        "type": "Stack",
        "items": [
          { "type": "Optional", "items": [{ "type": "Sequence", "items": ["name:", { "type": "Terminal", "label": "<string>" }] }], "skip": true },
          { "type": "Optional", "items": [{ "type": "Sequence", "items": ["description:", { "type": "Terminal", "label": "<string>" }] }], "skip": true },
          { "type": "Optional", "items": [{ "type": "Sequence", "items": ["argument-hint:", { "type": "Terminal", "label": "<string>" }] }], "skip": true },
          { "type": "Optional", "items": [{ "type": "Sequence", "items": ["agent:", { "type": "NonTerminal", "label": "Agent Target" }] }], "skip": true },
          { "type": "Optional", "items": [{ "type": "Sequence", "items": ["model:", { "type": "Terminal", "label": "<model-name> (vendor)" }] }], "skip": true },
          { "type": "Optional", "items": [{ "type": "Sequence", "items": ["tools:", { "type": "NonTerminal", "label": "Tool List" }] }], "skip": true }
        ]
      }
    },

    "Agent Target": {
      "description": "Built-in agent or custom agent to execute the prompt",
      "definition": {
        "type": "Choice",
        "default": 0,
        "items": [
          { "type": "Terminal", "label": "ask" },
          { "type": "Terminal", "label": "agent" },
          { "type": "Terminal", "label": "plan" },
          { "type": "Terminal", "label": "<custom-agent-name>" }
        ]
      }
    },

    "Tool List": {
      "description": "YAML array of tool identifiers (same as agent-md)",
      "definition": {
        "type": "Sequence",
        "items": [
          "[",
          { "type": "OneOrMore", "items": [
            { "type": "Choice", "default": 0, "items": [
              { "type": "Terminal", "label": "<tool-name>" },
              { "type": "Terminal", "label": "<server-name>/*" },
              { "type": "Terminal", "label": "<tool-set-name>" }
            ]},
            ","
          ]},
          "]"
        ]
      }
    }
  }
}
