{
  "meta": {
    "title": "Agent Skill (SKILL.md) Frontmatter",
    "description": "Railroad diagram for the YAML frontmatter schema of agent skills (SKILL.md) per agentskills.io specification",
    "source": "https://agentskills.io/specification",
    "version": "2026-04"
  },
  "rules": {
    "SKILL-md File": {
      "description": "Complete structure of a SKILL.md agent skill file",
      "definition": {
        "type": "Sequence",
        "items": [
          "---",
          { "type": "NonTerminal", "label": "Frontmatter Fields" },
          "---",
          { "type": "NonTerminal", "label": "Body (Markdown)" }
        ]
      }
    },

    "Frontmatter Fields": {
      "description": "Required and optional fields per agentskills.io spec",
      "definition": {
        "type": "Stack",
        "items": [
          { "type": "Sequence", "items": ["name:", { "type": "Terminal", "label": "<lowercase-hyphenated>" }] },
          { "type": "Sequence", "items": ["description:", { "type": "Terminal", "label": "<max 1024 chars>" }] },
          { "type": "Optional", "items": [{ "type": "Sequence", "items": ["license:", { "type": "Terminal", "label": "<SPDX identifier>" }] }], "skip": true },
          { "type": "Optional", "items": [{ "type": "NonTerminal", "label": "Dependencies Block" }], "skip": true },
          { "type": "Optional", "items": [{ "type": "NonTerminal", "label": "Compatibility Block" }], "skip": true },
          { "type": "Optional", "items": [{ "type": "NonTerminal", "label": "Metadata Block" }], "skip": true },
          { "type": "Optional", "items": [{ "type": "NonTerminal", "label": "Allowed-Tools Block" }], "skip": true },
          { "type": "Optional", "items": [{ "type": "NonTerminal", "label": "Hooks Block" }], "skip": true }
        ]
      }
    },

    "Dependencies Block": {
      "description": "External dependency declarations",
      "definition": {
        "type": "Sequence",
        "items": [
          "dependencies:",
          { "type": "OneOrMore", "items": [
            { "type": "Sequence", "items": [
              "-",
              { "type": "Sequence", "items": ["name:", { "type": "Terminal", "label": "<package>" }] },
              { "type": "Optional", "items": [{ "type": "Sequence", "items": ["version:", { "type": "Terminal", "label": "<semver>" }] }], "skip": true }
            ]}
          ]}
        ]
      }
    },

    "Compatibility Block": {
      "description": "Platform and agent compatibility",
      "definition": {
        "type": "Sequence",
        "items": [
          "compatibility:",
          { "type": "Optional", "items": [
            { "type": "Sequence", "items": [
              "platforms:",
              { "type": "OneOrMore", "items": [
                { "type": "Choice", "default": 0, "items": [
                  { "type": "Terminal", "label": "windows" },
                  { "type": "Terminal", "label": "macos" },
                  { "type": "Terminal", "label": "linux" }
                ]},
                ","
              ]}
            ]}
          ], "skip": true },
          { "type": "Optional", "items": [
            { "type": "Sequence", "items": [
              "agents:",
              { "type": "OneOrMore", "items": [
                { "type": "Choice", "default": 0, "items": [
                  { "type": "Terminal", "label": "copilot" },
                  { "type": "Terminal", "label": "claude" },
                  { "type": "Terminal", "label": "cursor" }
                ]},
                ","
              ]}
            ]}
          ], "skip": true }
        ]
      }
    },

    "Hooks Block": {
      "description": "Lifecycle hooks configuration (PostToolUse / Stop)",
      "definition": {
        "type": "Sequence",
        "items": [
          "hooks:",
          { "type": "Optional", "items": [
            { "type": "Group", "label": "PostToolUse", "items": [
              { "type": "Sequence", "items": [
                { "type": "Sequence", "items": ["event:", { "type": "Terminal", "label": "PostToolUse" }] },
                { "type": "Optional", "items": [{ "type": "Sequence", "items": ["matchers:", { "type": "NonTerminal", "label": "Matcher List" }] }], "skip": true },
                { "type": "Sequence", "items": ["steps:", { "type": "NonTerminal", "label": "Step List" }] }
              ]}
            ]}
          ], "skip": true },
          { "type": "Optional", "items": [
            { "type": "Group", "label": "Stop", "items": [
              { "type": "Sequence", "items": [
                { "type": "Sequence", "items": ["event:", { "type": "Terminal", "label": "Stop" }] },
                { "type": "Sequence", "items": ["steps:", { "type": "NonTerminal", "label": "Step List" }] }
              ]}
            ]}
          ], "skip": true }
        ]
      }
    }
  }
}
