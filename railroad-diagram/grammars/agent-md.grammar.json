{
  "meta": {
    "title": "VS Code Custom Agent (.agent.md) Frontmatter",
    "description": "Railroad diagram for the YAML frontmatter schema of VS Code custom agent files (.agent.md)",
    "source": "https://code.visualstudio.com/docs/copilot/customization/custom-agents",
    "version": "2026-04"
  },
  "rules": {
    "agent-md File": {
      "description": "Complete structure of a .agent.md custom agent file",
      "definition": {
        "type": "Sequence",
        "items": [
          "---",
          { "type": "NonTerminal", "label": "Frontmatter Fields" },
          "---",
          { "type": "NonTerminal", "label": "Body (Markdown)" }
        ]
      }
    },

    "Frontmatter Fields": {
      "description": "All available YAML frontmatter fields (all optional)",
      "definition": {
        "type": "Stack",
        "items": [
          { "type": "Optional", "items": [{ "type": "Sequence", "items": ["name:", { "type": "Terminal", "label": "<string>" }] }], "skip": true },
          { "type": "Optional", "items": [{ "type": "Sequence", "items": ["description:", { "type": "Terminal", "label": "<string>" }] }], "skip": true },
          { "type": "Optional", "items": [{ "type": "Sequence", "items": ["argument-hint:", { "type": "Terminal", "label": "<string>" }] }], "skip": true },
          { "type": "Optional", "items": [{ "type": "Sequence", "items": ["model:", { "type": "NonTerminal", "label": "Model Spec" }] }], "skip": true },
          { "type": "Optional", "items": [{ "type": "Sequence", "items": ["tools:", { "type": "NonTerminal", "label": "Tool List" }] }], "skip": true },
          { "type": "Optional", "items": [{ "type": "Sequence", "items": ["agents:", { "type": "NonTerminal", "label": "Agent List" }] }], "skip": true },
          { "type": "Optional", "items": [{ "type": "Sequence", "items": ["handoffs:", { "type": "NonTerminal", "label": "Handoff List" }] }], "skip": true },
          { "type": "Optional", "items": [{ "type": "Sequence", "items": ["hooks:", { "type": "NonTerminal", "label": "Hooks Config" }] }], "skip": true },
          { "type": "Optional", "items": [{ "type": "NonTerminal", "label": "Visibility Fields" }], "skip": true }
        ]
      }
    },

    "Model Spec": {
      "description": "A single model name or a prioritized list of model names",
      "definition": {
        "type": "Choice",
        "default": 0,
        "items": [
          { "type": "Terminal", "label": "<model-name> (vendor)" },
          { "type": "Sequence", "items": [
            "[",
            { "type": "OneOrMore", "items": [
              { "type": "Terminal", "label": "<model-name> (vendor)" },
              ","
            ]},
            "]"
          ]}
        ]
      }
    },

    "Tool List": {
      "description": "YAML array of tool identifiers",
      "definition": {
        "type": "Sequence",
        "items": [
          "[",
          { "type": "OneOrMore", "items": [
            { "type": "NonTerminal", "label": "Tool Reference" },
            ","
          ]},
          "]"
        ]
      }
    },

    "Tool Reference": {
      "description": "A tool name, tool set, MCP server tools, or wildcard",
      "definition": {
        "type": "Choice",
        "default": 0,
        "items": [
          { "type": "Terminal", "label": "<tool-name>" },
          { "type": "Terminal", "label": "<server-name>/*" },
          { "type": "Terminal", "label": "<tool-set-name>" }
        ]
      }
    },

    "Agent List": {
      "description": "Subagents available to this agent",
      "definition": {
        "type": "Choice",
        "default": 0,
        "items": [
          { "type": "Terminal", "label": "*" },
          { "type": "Terminal", "label": "[]" },
          { "type": "Sequence", "items": [
            "[",
            { "type": "OneOrMore", "items": [
              { "type": "Terminal", "label": "<agent-name>" },
              ","
            ]},
            "]"
          ]}
        ]
      }
    },

    "Handoff Entry": {
      "description": "A single handoff definition with target agent and prompt",
      "definition": {
        "type": "Sequence",
        "items": [
          "-",
          { "type": "Sequence", "items": ["label:", { "type": "Terminal", "label": "<display text>" }] },
          { "type": "Sequence", "items": ["agent:", { "type": "Terminal", "label": "<agent-id>" }] },
          { "type": "Optional", "items": [{ "type": "Sequence", "items": ["prompt:", { "type": "Terminal", "label": "<text>" }] }], "skip": true },
          { "type": "Optional", "items": [{ "type": "Sequence", "items": ["send:", { "type": "Choice", "default": 1, "items": ["true", "false"] }] }], "skip": true },
          { "type": "Optional", "items": [{ "type": "Sequence", "items": ["model:", { "type": "Terminal", "label": "<model-name>" }] }], "skip": true }
        ]
      }
    },

    "Visibility Fields": {
      "description": "Control agent visibility in picker and subagent invocation",
      "definition": {
        "type": "Choice",
        "default": 0,
        "items": [
          { "type": "Sequence", "items": ["user-invocable:", { "type": "Choice", "default": 0, "items": ["true", "false"] }] },
          { "type": "Sequence", "items": ["disable-model-invocation:", { "type": "Choice", "default": 1, "items": ["true", "false"] }] },
          { "type": "Sequence", "items": ["target:", { "type": "Choice", "default": 0, "items": ["vscode", "github-copilot"] }] }
        ]
      }
    }
  }
}
