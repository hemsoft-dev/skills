{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Meeting Preparation Template",
  "type": "object",
  "required": ["title", "dateTime"],
  "properties": {
    "title": {
      "type": "string",
      "description": "Meeting title"
    },
    "host": {
      "type": "string",
      "description": "Person hosting the meeting (optional)"
    },
    "dateTime": {
      "type": "string",
      "description": "Date and time of the meeting (ISO 8601 format preferred)",
      "examples": ["2026-02-15T10:00:00-05:00", "February 15, 2026 at 10:00 AM EST"]
    },
    "participants": {
      "type": "array",
      "description": "List of participants (optional if audienceDescription is provided)",
      "items": {
        "type": "string"
      }
    },
    "audienceDescription": {
      "type": "string",
      "description": "Description of the audience (required if participants not provided)"
    },
    "skillLevel": {
      "type": "integer",
      "description": "Microsoft skill level (100, 200, 300, or 400)",
      "enum": [100, 200, 300, 400]
    },
    "observations": {
      "type": "string",
      "description": "Optional observations or notes about the meeting"
    },
    "brainstorming": {
      "type": "array",
      "description": "Random ideas, thoughts, or notes captured before the meeting",
      "items": {
        "type": "string"
      }
    },
    "preparationTasks": {
      "type": "array",
      "description": "List of preparation tasks",
      "items": {
        "type": "object",
        "required": ["task", "status"],
        "properties": {
          "task": {
            "type": "string",
            "description": "Task description"
          },
          "status": {
            "type": "string",
            "enum": ["complete", "incomplete"],
            "description": "Task completion status"
          },
          "resources": {
            "type": "array",
            "description": "Research links and resources",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "notes": {
            "type": "string",
            "description": "Brief notes (max 1 paragraph)"
          }
        }
      }
    }
  }
}
